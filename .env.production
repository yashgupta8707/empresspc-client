# Production Environment Variables
# These will be used when building for production

# API URL - Use relative path if frontend and backend are on same domain
# Or specify full URL if they're on different domains
VITE_API_URL=/api

VITE_APP_NAME=Empress Tech
VITE_ENABLE_ANALYTICS=true


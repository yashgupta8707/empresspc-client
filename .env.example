# Empress Tech - Frontend Environment Variables Example
# Copy this file to .env.local for development

# API Configuration
# For development, leave this blank to use default http://localhost:5000/api
# For production, set to your production API URL
VITE_API_URL=

# App Configuration
VITE_APP_NAME=Empress Tech
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CHAT=false

# Third-party Services (if needed on frontend)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_RAZORPAY_KEY_ID=
